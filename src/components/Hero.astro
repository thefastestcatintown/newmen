---
import { languageFromPath, translator, sitePath } from '../i18n/utils';
const lang = languageFromPath(Astro.url.pathname);
const t = translator(lang);
import Button from './Button.astro';
---
<section class="hero wrap" aria-labelledby="hero-title">
  <div class="hero-copy">
    <p class="eyebrow"><span class="status-dot"></span> {t("SELF-LEADERSHIP & MEN'S WORK · BERLIN")}</p>
    <h1 id="hero-title">{t("Feel like")}<br />{t("a")} <em>{t("(new)")}</em> {t("man.")}</h1>
    <div class="hero-description"><h2>{t("A place to come home")}<br class="desktop-break" /> {t("to yourself.")}</h2><p>{t("Build a safer relationship with yourself. Make room for who you are. Learn to move through life with a little more presence, and a little less armour.")}</p></div>
    <div class="actions"><Button href="#contact">{t("Let's talk")}</Button><a class="text-link" href="#approach">{t("Explore the approach")} <span aria-hidden="true">↓</span></a></div>
  </div>
  <figure class="hero-portrait"><div class="photo-frame"><img src={sitePath('/images/leon-czalaun.jpg')} alt={t("Leon Czalaun, hands resting on his chest, in a leafy brick courtyard")} width="1500" height="2193" fetchpriority="high" /><span class="photo-note" aria-hidden="true">{t("A little more present.")}<br />{t("A little more you.")}</span></div><figcaption><span>LEON CZALAUN · AKA MUFASA</span><span>BERLIN, DE ↗</span></figcaption></figure>
  <div class="hero-bottom"><span>{t("A practice of becoming yourself.")}</span><a href="#coming-home">{t("COME HOME")} <span aria-hidden="true">↓</span></a></div>
</section>
