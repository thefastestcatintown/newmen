---
import { languageFromPath, translator, localizePath } from '../i18n/utils';
const lang = languageFromPath(Astro.url.pathname);
const t = translator(lang);
const endpoint = import.meta.env.PUBLIC_CONTACT_ENDPOINT || '';
---
<section class="invitation section wrap" aria-labelledby="invitation-title"><p class="eyebrow">{t("A CONVERSATION IS A GOOD PLACE TO START")}</p><h2 id="invitation-title">{t("Curious")}<span class="accent">?</span></h2><p>{t("You don't need to take my word for any of this.")}<br />{t("Meet me, and decide for yourself.")}</p><a class="text-link" href="#contact">{t("Let's meet.")} <span aria-hidden="true">↘</span></a></section>
<section id="contact" class="contact section wrap" aria-labelledby="contact-title"><div><p class="eyebrow">{t("LET'S TALK")}</p><h2 id="contact-title" class="editorial-heading">{t("Come as")}<br /><em>{t("you are.")}</em></h2><p>{t("A few words about yourself are enough.")}<br />{t("There's no perfect place to begin.")}</p></div>
  <form id="contact-form" data-endpoint={endpoint} data-state="idle" aria-describedby="form-note">
    <div class="form-row"><label for="name">{t("Name")}<input id="name" name="name" autocomplete="name" required maxlength="120" /></label><label for="email">{t("Email")}<input id="email" name="email" type="email" autocomplete="email" required maxlength="254" /></label></div>
    <label for="phone">{t("Phone")} <span>{t("(optional)")}</span><input id="phone" name="phone" type="tel" autocomplete="tel" maxlength="50" /></label>
    <label for="message">{t("What brings you here?")}<textarea id="message" name="message" rows="3" required maxlength="5000"></textarea></label>
    <p id="form-note" class="form-note">{t(endpoint ? 'Share only what you feel comfortable sharing here.' : 'The contact form is not accepting messages yet. Please check back soon.')}</p>
    <noscript><p>{t("This form needs JavaScript to send a message.")}</p></noscript>
    <div class="form-bottom"><p class="form-note">{t("Read the")} <a href={localizePath("/privacy/", lang)}>{t("privacy notice")}</a>.</p><button class="button" type="submit">{t("Send")} <span aria-hidden="true">↗</span></button></div>
    <p id="form-status" class="form-status" role="status" aria-live="polite" aria-atomic="true"></p>
  </form>
</section>
<script>
  import { translator, languageFromPath } from '../i18n/utils';
  const t = translator(languageFromPath(window.location.pathname));
  const form = document.querySelector<HTMLFormElement>('#contact-form');
  const status = document.querySelector<HTMLElement>('#form-status');
  const button = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
  form?.addEventListener('submit', async event => {
    event.preventDefault();
    if (!status || !button || form.dataset.state === 'sending') return;
    const endpoint = form.dataset.endpoint;
    if (!endpoint) {
      form.dataset.state = 'error';
      status.textContent = t("Sending is not available yet. Your message has not been sent.");
      return;
    }
    form.dataset.state = 'sending';
    form.setAttribute('aria-busy', 'true');
    button.disabled = true;
    button.textContent = t("Sending\u2026");
    status.textContent = t("Sending your message\u2026");
    try {
      const response = await fetch(endpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(Object.fromEntries(new FormData(form))),
        signal: AbortSignal.timeout(15000),
      });
      if (!response.ok) throw new Error('Request failed');
      const result = await response.json();
      if (result.success !== true) throw new Error('Message was not accepted');
      form.dataset.state = 'success';
      status.textContent = t("Thank you. Your message has been received.");
      form.reset();
    } catch {
      form.dataset.state = 'error';
      status.textContent = t("We couldn't confirm delivery. Your words are still here; please try again in a moment.");
    } finally {
      form.removeAttribute('aria-busy');
      button.disabled = false;
      button.textContent = t('Send') + ' ↗';
    }
  });
</script>
