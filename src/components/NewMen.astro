---
import { languageFromPath, translator } from '../i18n/utils';
const lang = languageFromPath(Astro.url.pathname);
const t = translator(lang);
import Button from './Button.astro';
const principles = [ ['Confidentiality', "Other people's stories stay in the space. You choose what to share about your own experience."], ['Honesty', 'We practise speaking honestly about where we are, with care for ourselves and one another.'], ['Acceptance', "We meet each person's experience with openness, without needing it to match our own."], ['Ownership', 'We take responsibility for our presence, our choices and our individual process.'], ['Respect for vulnerability', 'Being seen can take courage. We honour that trust and respect individual boundaries.'] ];
---
<section id="new-men" class="men-section section" aria-labelledby="new-men-title"><div class="wrap">
  <div class="offer-heading"><p class="eyebrow">{t("II. / THE RELATIONSHIP WITH EACH OTHER")}</p><h2 id="new-men-title" class="offer-title">NEW<span>/</span>MEN</h2><p class="offer-type">{t("1:1 · GROUPS · EVENTS")}</p></div>
  <div class="men-intro"><h3>{t("We carry a lot.")}<br /><em>{t("We don't have to")}<br />{t("carry it alone.")}</em></h3><div><p>{t("Many men show very little of what they carry. Here, positive masculinity means making room for honesty, connection and responsibility — and learning to be present with each other.")}</p><p>{t("We practise sharing how we really are. Listening without immediately fixing or judging. Witnessing another person's experience, and taking ownership of our own.")}</p><p>{t("This is how we begin to become the male role models we would like to see: curious, respectful, and willing to learn.")}</p><Button href="#contact">{t("NEW/MEN intro call")}</Button></div></div>
  <div class="principles"><p class="eyebrow">{t("HOW WE HOLD THE SPACE")}</p><div>{principles.map(([title, description], i) => <details><summary><span class="principle-number">0{i + 1}</span>{t(title)}<span class="expand" aria-hidden="true">+</span></summary><p>{t(description)}</p></details>)}</div></div>
</div></section>
